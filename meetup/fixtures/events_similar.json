{"data":{"similarEvents":{"edges":[{"node":{"id":"317213249","title":"Optimizing React Apps","status":"ACTIVE","isSaved":false,"featuredEventPhoto":null,"displayPhoto":{"source":"https://secure.meetupstatic.com/photos/event/c/a/e/5/highres_521511941.jpeg","baseUrl":"https://secure-content.meetupstatic.com/images/classic-events/","highResUrl":"https://secure.meetupstatic.com/photos/event/c/a/e/5/highres_521511941.jpeg","id":"521511941","__typename":"PhotoInfo"},"description":"Is your React app slow, and you're not sure why? Join us for a hands-on talk on React performance — no theory-only slides, every claim gets proven live.\n\nCharles Inwald walks through the real culprits behind sluggish React apps — unnecessary re-renders, misplaced state and Context, unvirtualized lists, bloated bundles — and fixes each one live, on stage, with side-by-side \"Slow vs. Fast\" demos timed in the browser.\n\n**Doors open at 2pm, talk starts at 3pm, arrive early for networking and light refreshments.**\n\nJoin the NJ Code & Coffee Community Discord - come hang out before and after:\n[www.codeandcoffee.chat](http://www.codeandcoffee.chat/)\n\n**The Speaker:** Charles Inwald- Full Stack Developer, React enthusiast, previously worked at Apple and startups","isOnline":false,"eventType":"PHYSICAL","venue":{"id":"27814246","name":"EqualSpace ES550 Tech & Innovation Campus","address":"550 Broad St","city":"Newark","state":"NJ","country":"us","__typename":"Venue"},"isAttending":false,"eventUrl":"https://www.meetup.com/nj-code-coffee/events/317213249/","going":{"totalCount":16,"__typename":"GoingRsvpConnection"},"dateTime":"2026-12-12T15:00:00-05:00","endTime":"2026-12-12T16:00:00-05:00","isFeatured":false,"group":{"id":"37619411","name":"NJ Code & Coffee","timezone":"America/New_York","__typename":"Group"},"actions":[],"isNetworkEvent":false,"rsvpState":"JOIN_OPEN","rsvps":{"edges":[{"node":{"id":"2086103531","member":{"id":"282571394","name":"Raphael Husbands","memberPhoto":{"id":"31952894